{
  "name": "cityfix-backend",
  "version": "1.0.0",
  "description": "CityFix REST API - Node.js + Express + NeonDB (serverless Postgres)",
  "private": true,
  "type": "module",
  "main": "server.js",
  "keywords": [
    "express",
    "neondb",
    "postgres",
    "cityfix",
    "rest-api"
  ],
  "license": "ISC",
  "homepage": "https://github.com/NurulAfsar12/CityFIX#readme",
  "author": "Nurul Afsar <https://github.com/NurulAfsar12>",
  "contributors": [
    "Nurul Afsar <https://github.com/NurulAfsar12>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NurulAfsar12/CityFIX.git"
  },
  "bugs": {
    "url": "https://github.com/NurulAfsar12/CityFIX/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "npm run migrate && npm run seed"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  }
}